{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storycast-billing",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "APPLE_ENVIRONMENT": "sandbox" },
  "d1_databases": [
    { "binding": "DB", "database_name": "storycast-billing", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Shared by /accounts, /jobs, /calls and /upload. One long family film bursts ~220 calls, so the old 30/60s
  // throttled a legitimate production mid-run; 120/60s still cuts off a runaway client.
  "ratelimits": [
    { "name": "ACCOUNT_LIMIT", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } }
  ]
}
