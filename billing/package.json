{
  "name": "storycast-billing",
  "version": "0.1.0",
  "description": "Storycast billing API: credits, plans, App Store subscriptions, fal proxy",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "wrangler d1 execute storycast-billing --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute storycast-billing --local --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "^3.2.0",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
